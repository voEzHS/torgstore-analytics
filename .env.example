# TorgStore Analytics — переменные окружения
# Скопируй в .env и заполни своими значениями

# Подключение к Supabase PostgreSQL
# Найти в Supabase Dashboard → Project Settings → Database → Connection String → URI
# Формат для asyncpg: postgresql+asyncpg://postgres.[ref]:[password]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/torgstore

# Supabase (для Storage и Auth — опционально)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-key

# Приложение
APP_ENV=development   # development | production
SECRET_KEY=change-me-in-production

# AI аналитик (Claude от Anthropic)
# Получить ключ: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key
