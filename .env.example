# TorgStore Analytics — переменные окружения
# Скопируй в .env и заполни своими значениями

# Подключение к PostgreSQL (локально — docker-compose, на Render — managed Postgres)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/torgstore

# Приложение
APP_ENV=development   # development | production
SECRET_KEY=change-me-in-production

# AI аналитик (Claude от Anthropic)
# Получить ключ: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key

# ── Публичный доступ (Render) ───────────────────────────────────────────
# Сайт содержит реальные ФИО клиентов, телефоны, выручку и данные по
# менеджерам. Локально можно оставить пустыми — авторизация выключена
# автоматически, если оба поля пустые. На Render — ОБЯЗАТЕЛЬНО заполнить.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# Список разрешённых доменов через запятую (например https://torgstore.onrender.com).
# Пусто = разрешены все источники (ок для локальной разработки, не для прод).
ALLOWED_ORIGINS=
